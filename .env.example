# ──────────────────────────────────────────────────────────────────────────────
# Variables d'environnement pour le déploiement Docker (docker-compose.prod.yml)
# Copiez ce fichier en .env et renseignez les valeurs avant de lancer le docker-compose.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_USER=lpo_user
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
POSTGRES_DB=lpo_db

# ── Backend (NestJS) ─────────────────────────────────────────────────────────
# URL publique du backend (vue depuis l'extérieur, avec le port si nécessaire)
APP_URL=https://api.votre-domaine.fr
# URL publique du backoffice (pour les liens dans les e-mails de réinitialisation)
BACKOFFICE_URL=https://backoffice.votre-domaine.fr

# Secrets JWT — Générez des clés aléatoires fortes (ex: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=180d

# ── Backoffice (Next.js) ─────────────────────────────────────────────────────
# URL de l'API backend vue depuis le navigateur de l'utilisateur
# ATTENTION : c'est une variable de BUILD TIME, pas de runtime.
# Si vous changez cette valeur, il faut reconstruire l'image du backoffice.
NEXT_PUBLIC_BACKEND_URL=https://api.votre-domaine.fr/api
